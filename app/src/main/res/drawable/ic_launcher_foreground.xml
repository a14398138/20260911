<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Starfighter Thruster Glow -->
    <path
        android:pathData="M50,72 L54,88 L58,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="72"
                android:endX="54"
                android:endY="88"
                android:type="linear">
                <item android:color="#FFFF3366" android:offset="0.0" />
                <item android:color="#00FF9900" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Left Wing Flame -->
    <path
        android:pathData="M37,70 L39,80 L42,70 Z"
        android:fillColor="#00E5FF" />
    <!-- Right Wing Flame -->
    <path
        android:pathData="M66,70 L69,80 L71,70 Z"
        android:fillColor="#00E5FF" />
    <!-- Spaceship Main Hull -->
    <path
        android:pathData="M54,22 L68,68 L54,62 L40,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="22"
                android:endX="54"
                android:endY="68"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#00E5FF" android:offset="0.7" />
                <item android:color="#0077B6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Left Swept Wing -->
    <path
        android:pathData="M40,54 L24,70 L38,68 L44,58 Z"
        android:fillColor="#00B4D8" />
    <!-- Right Swept Wing -->
    <path
        android:pathData="M68,54 L84,70 L70,68 L64,58 Z"
        android:fillColor="#00B4D8" />
    <!-- Cockpit Canopy -->
    <path
        android:pathData="M54,34 L58,50 L54,53 L50,50 Z"
        android:fillColor="#FFD600" />
    <!-- Neon Wing Accents -->
    <path
        android:pathData="M24,70 L36,48"
        android:strokeWidth="1.5"
        android:strokeColor="#FF007F" />
    <path
        android:pathData="M84,70 L72,48"
        android:strokeWidth="1.5"
        android:strokeColor="#FF007F" />
    <path
        android:pathData="M54,20 L54,28"
        android:strokeWidth="2"
        android:strokeColor="#00FFFF" />
</vector>
